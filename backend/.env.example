PORT=4000
CONFIG_PATH=../config/house.json

# KNX gateway can be overridden here; otherwise falls back to house.json
# KNX_GATEWAY_HOST=192.168.1.10
# KNX_GATEWAY_PORT=3671

# Security
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

# Milliseconden na start voor connectivity-rapport in logs (KNX + media).
# STARTUP_CONNECTIVITY_REPORT_MS=5000


# 0 = echte KNX gateway. 1 = software-simulatie (geen UDP naar bus; handig op laptop).
KNX_SIMULATE=1

# ---- Cameras ----
# Public base URL of the go2rtc API (as reachable by phones on the LAN).
# On the NUC this is typically http://<nuc-lan-ip>:1984
MEDIA_BASE_URL=http://localhost:1984

# Public base URL of THIS backend, as reachable by phones. The backend
# uses it when emitting absolute snapshot URLs. Leave blank for relative.
PUBLIC_API_BASE=

# Software version string for GET /api/version (Docker sets this from pubspec).
# APP_VERSION=0.2.0+48

# GitHub repo for update banners (releases/tags). Private repos need a token.
# GITHUB_REPO=Archie-Automation/visualisatie
# GITHUB_TOKEN=

# If set, the backend will (re)generate go2rtc.yaml from house.json on boot
# and on POST /api/config/reload. Point at the file go2rtc actually reads.
GO2RTC_CONFIG_PATH=../docker/go2rtc/go2rtc.yaml

# 1 = start go2rtc automatically on the same machine as this backend.
# Production Docker image includes go2rtc + ffmpeg; this stays on for that stack.
# Set to 0 only if you run go2rtc elsewhere and only want this Node process.
GO2RTC_AUTO_START=1

# Optioneel volledig pad naar go2rtc(.exe) als het niet op PATH staat (Windows-dev: zie repo /tools).
# GO2RTC_BIN=C:\Users\gebruiker\KNX app\tools\go2rtc.exe

# ffmpeg: nodig voor camera's met go2rtcFfmpeg. Standaard: ../tools/ffmpeg(.exe) of /usr/bin/ffmpeg (Docker).
# FFMPEG_PATH=C:\pad\naar\ffmpeg.exe

# ---- Spotify ----
# Eén keer aanmaken op https://developer.spotify.com/dashboard (gratis) en hier
# invullen in het installatie-image. De klant hoeft dan alleen nog in te loggen
# via Instellingen > Spotify. Laat leeg om het per installatie in de app in te vullen.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Redirect URI: laat leeg. Op de NUC gebruikt de server
# https://<LAN-IP>:4443/api/media/spotify/callback (zelf-getekend certificaat).
# SPOTIFY_REDIRECT_URI=
