# Archie Cloud VPS — kopieer naar .env en vul in.

# Publiek IPv4 van deze VPS (voor coturn en de wg-endpoint die klanten krijgen).
PUBLIC_IP=203.0.113.10

# Basisdomein. Klanten krijgen <serverId>.${DOMAIN}; enroll.${DOMAIN} en turn.${DOMAIN} wijzen hierheen.
DOMAIN=archiecloud.nl

# Gedeeld TURN-geheim (coturn use-auth-secret). Elke NUC krijgt dit bij enrollment.
#   openssl rand -hex 32
TURN_SECRET=vervang-door-64-hex-tekens

# Token voor beheer-calls op de enrollment-API (cli.mjs gebruikt dit lokaal).
#   openssl rand -hex 24
ENROLL_ADMIN_TOKEN=vervang-door-lange-string

# WireGuard-hub
WG_SUBNET=10.80.0.0/16
WG_SERVER_ADDRESS=10.80.0.1
WG_PORT=51820

# E-mail voor Let's Encrypt
ACME_EMAIL=beheer@archiecloud.nl
