# Archie Cloud VPS — kopieer naar .env en vul in.

# Publiek IPv4 van deze VPS (voor coturn en de wg-endpoint die klanten krijgen).
PUBLIC_IP=203.0.113.10

# Basisdomein. Klanten krijgen <serverId>.${DOMAIN}; enroll.${DOMAIN} en turn.${DOMAIN} wijzen hierheen.
DOMAIN=archiecloud.nl

# Gedeeld TURN-geheim (coturn use-auth-secret). Elke NUC krijgt dit bij enrollment.
#   openssl rand -hex 32
TURN_SECRET=vervang-door-64-hex-tekens

# Token voor beheer-calls op de enrollment-API (cli.mjs gebruikt dit lokaal).
#   openssl rand -hex 24
ENROLL_ADMIN_TOKEN=vervang-door-lange-string

# WireGuard-hub
WG_SUBNET=10.80.0.0/16
WG_SERVER_ADDRESS=10.80.0.1
WG_PORT=51820

# E-mail voor Let's Encrypt
ACME_EMAIL=beheer@archiecloud.nl

# Koppellink opent de native app (App Links). SHA256 van het APK-certificaat;
# meerdere mag, kommagescheiden. Leeg = alleen web-app via browser.
#   keytool -list -v -keystore app/android/sideload.jks -alias upload
ANDROID_PACKAGE=com.example.luxe_knx
ANDROID_CERT_SHA256=E0:B9:AB:E9:0B:C7:30:9F:53:0D:1F:FE:DD:B6:74:99:6E:36:72:49:64:60:4A:11:A7:A5:5A:08:D5:73:98:DA

# iOS Universal Links (pas als er een Apple Developer-account en iOS-build is).
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.example.luxeKnx

# Deurbel-push bij gesloten app (Firebase Cloud Messaging).
# 1. Firebase-project maken, Android-app toevoegen met package com.example.luxe_knx.
# 2. Projectinstellingen → Serviceaccounts → Nieuwe privésleutel → opslaan als
#    cloud/data/enroll/firebase-service-account.json (NIET in git).
# 3. Projectinstellingen → Algemeen → je Android-app: de vier waarden hieronder.
#    Deze zijn publiek (staan in elke APK); de servicesleutel is het geheim.
FCM_CLIENT_CONFIG={"apiKey":"AIza...","appId":"1:1234567890:android:abc123","projectId":"archie-cloud","messagingSenderId":"1234567890"}
