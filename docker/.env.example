# Wordt automatisch aangemaakt door ./install.sh / ./installeer.sh.
# Handmatig alleen nodig als je iets wilt overschrijven.

JWT_SECRET=vervang-door-lange-willekeurige-string

# go2rtc op dezelfde machine (niet de telefoon-URL).
MEDIA_BASE_URL=http://127.0.0.1:1984

# Publieke URL van de app op het LAN (install.sh vult dit met het VM-IP).
# PUBLIC_API_BASE=http://192.168.1.50:4000
# HTTPS voor Spotify-callback (Spotify weigert http://192.168.x):
# HTTPS_PORT=4443
# Optioneel: publieke HTTPS-bounce (geen certificaatwaarschuwing), zie oauth/spotify-callback.html
# SPOTIFY_OAUTH_BOUNCE=

# ── Remote toegang via Archie Cloud (gevuld door install.sh na enrollment) ──
# Leeg laten = alleen LAN. Zie cloud/README.md.
# SERVER_ID=a1b2c3d4
# REMOTE_URL=https://a1b2c3d4.archiecloud.nl
# WG_ADDRESS=10.80.1.2
# TURN_HOST=turn.archiecloud.nl
# TURN_SECRET=gedeeld-geheim-van-coturn
# TURN_TTL=3600
# Optioneel: VPS-poort die naar deze NUC:8555 forwardt (goedkoper dan TURN).
# GO2RTC_RELAY_CANDIDATE=203.0.113.10:40012

# GitHub-repo voor “nieuwe versie”-melding in de app (releases of tags).
GITHUB_REPO=Archie-Automation/visualisatie
# Alleen nodig als de repo privé is, of voor API-calls (releases/APK).
# Public: leeg laten. Een verlopen token kan git fetch juist laten falen.
# GITHUB_TOKEN=ghp_...
