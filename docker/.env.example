# Kopieer naar .env en pas aan voordat je ./up.sh of docker compose draait.

JWT_SECRET=vervang-door-lange-willekeurige-string

# Basis-URL van go2rtc zoals clients die bereiken (telefoon = LAN-IP van de server).
# Voorbeeld: http://192.168.1.50:1984
MEDIA_BASE_URL=http://127.0.0.1:1984

# Optioneel: publieke URL van deze API (voor absolute snapshot-links).
# PUBLIC_API_BASE=http://192.168.1.50:4000
